{
  "name": "gourmerge",
  "version": "0.1.0",
  "private": true,
  "description": "Fork the recipe, merge the flavor. A GitHub-clone for recipes.",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-ingredients.mjs",
    "seed:swiss": "node scripts/import-swiss-foods.mjs",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^9.0.0",
    "@sentry/nuxt": "^10.57.0",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "@vueuse/core": "^14.3.0",
    "diff-match-patch-es": "^0.1.0",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.5",
    "mysql2": "^3.22.5",
    "nodemailer": "^8.0.11",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.0",
    "pino": "^10.3.1",
    "rotating-file-stream": "^3.2.9",
    "sanitize-html": "^2.17.5",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.38",
    "vue-router": "^4.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.61.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@vite-pwa/nuxt": "^0.10.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.6",
    "knip": "^6.17.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "sharp": "^0.35.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9",
    "xlsx": "^0.18.5"
  }
}
