{
  "name": "gourmerge",
  "version": "1.4.0",
  "private": true,
  "description": "Fork the recipe, merge the flavor. A GitHub-clone for recipes.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . && npm run design:check",
    "lint:fix": "eslint . --fix",
    "design:check": "node scripts/design-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-ingredients.mjs",
    "db:seed:tags": "node scripts/seed-tags.mjs",
    "db:cleanup": "node scripts/cleanup-retention.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:inactive": "node scripts/inactive-accounts.mjs",
    "db:setup": "npm run db:migrate && npm run seed:swiss && npm run db:seed && npm run db:seed:tags",
    "seed:swiss": "node scripts/import-swiss-foods.mjs",
    "seed:swiss:regen": "node scripts/import-swiss-foods.mjs --from-xlsx --emit-seed",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@sentry/nuxt": "^10.57.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "@vueuse/core": "^14.3.0",
    "diff-match-patch-es": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.5",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.1",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.0",
    "otpauth": "^9.5.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "rotating-file-stream": "^3.2.9",
    "sanitize-html": "^2.17.5",
    "tw-shimmer": "^0.4.12",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.38",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.61.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.6",
    "knip": "^6.17.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "sharp": "^0.35.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "fontless": {
      "esbuild": "^0.28.1"
    }
  }
}
