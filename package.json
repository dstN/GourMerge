{
  "name": "gourmerge",
  "version": "0.1.0",
  "private": true,
  "description": "Fork the recipe, merge the flavor. A GitHub-clone for recipes.",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "@nuxtjs/i18n": "^9.0.0",
    "@sentry/nuxt": "^10.57.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/vue-3": "^3.0.0",
    "diff-match-patch-es": "^0.1.0",
    "drizzle-orm": "^0.44.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^8.0.11",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.0",
    "pino": "^10.3.1",
    "pino-rotating-file-stream": "^0.0.2",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@types/nodemailer": "^8.0.1",
    "@vite-pwa/nuxt": "^0.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.3",
    "prettier": "^3.8.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
