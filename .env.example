# ── Database ──────────────────────────────────────────────────
DATABASE_URL=mysql://gourmerge:gourmerge_secret@localhost:3306/gourmerge

# ── Auth (nuxt-auth-utils) ────────────────────────────────────
# Minimum 32 characters. Auto-generated in dev if missing.
NUXT_SESSION_PASSWORD=your-super-secret-session-password-with-at-least-32-chars

# ── App ───────────────────────────────────────────────────────
NUXT_PUBLIC_APP_NAME=GourMerge
NUXT_PUBLIC_APP_SLOGAN="Fork the recipe, merge the flavor."
