# GourMerge — Environment Variables
# Copy this file to .env for local development.
# In production, inject these via Passenger env directives (never commit .env).

# ── Database ──────────────────────────────────────────────────────────────
# MariaDB connection string for Drizzle ORM + mysql2
DATABASE_URL=mysql://gourmerge:your_password@localhost:3306/gourmerge

# ── Session / Auth ────────────────────────────────────────────────────────
# nuxt-auth-utils session encryption key (min 32 chars, CSPRNG)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=replace_with_64_char_random_hex_string

# ── Email / SMTP (Netcup) ──────────────────────────────────────────────────
# Used for email verification and password reset flows (Phase 2)
SMTP_HOST=mail.your-domain.de
SMTP_PORT=587
SMTP_USER=noreply@your-domain.de
SMTP_PASS=your_smtp_password
SMTP_FROM="GourMerge <noreply@your-domain.de>"

# ── Sentry (Error Tracking) ───────────────────────────────────────────────
# From https://sentry.io → Project Settings → DSN (Phase 5)
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ── App ───────────────────────────────────────────────────────────────────
# NODE_ENV is set automatically by Nuxt/Nitro.
# Used for canonical URLs in emails and SEO meta.
NUXT_PUBLIC_APP_URL=https://your-domain.de
NUXT_PUBLIC_APP_NAME=GourMerge
NUXT_PUBLIC_APP_SLOGAN="Fork the recipe, merge the flavor."
