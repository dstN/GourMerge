# GourMerge — Environment Variables
# Copy this file to .env for local development.
# In production, inject these via Passenger env directives (never commit .env).

# ── Database ──────────────────────────────────────────────────────────────
# MySQL 8.4 connection string for Drizzle ORM + mysql2. Match production's major
# version (8.4) and never use MariaDB — the app issues MySQL-specific JSON and
# FULLTEXT SQL that behaves differently there.
#
# Pick ONE of the two (both can run side by side):
#
#   a) Native MySQL on the default port
DATABASE_URL=mysql://gourmerge:your_password@127.0.0.1:3306/gourmerge
#
#   b) The optional docker-compose container, published on 3307 so it does not
#      collide with a native install:
# DATABASE_URL=mysql://gourmerge:gourmerge_secret@127.0.0.1:3307/gourmerge

# ── Session / Auth ────────────────────────────────────────────────────────
# nuxt-auth-utils session encryption key (min 32 chars, CSPRNG)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=replace_with_64_char_random_hex_string

# ── Two-factor authentication (optional feature) ─────────────────
# Key for encrypting TOTP secrets at rest (AES-256-GCM). Min. 32 chars.
#
# Strongly recommended to set explicitly: without it the code falls back to
# NUXT_SESSION_PASSWORD, which means rotating the session secret would invalidate
# every enrolled authenticator app at once and lock those users out until they use
# a recovery code.
#
#   openssl rand -base64 48
TOTP_ENCRYPTION_KEY=

# ── Maintenance task trigger ─────────────────────────────────────
# Shared secret for the HTTP-triggered maintenance jobs, called by the Plesk
# scheduled task ("Fetch a URL"):
#
#   https://<domain>/tasks/retention?key=<CRON_SECRET>
#   https://<domain>/tasks/inactive-accounts?key=<CRON_SECRET>
#
# An HTTP trigger rather than a shell cron because the deploy ships only .output/
# and app.js — the host has no scripts/, no package.json and no .env, and a Plesk
# scheduled task does not inherit the PassengerEnvVar values that reach the app
# process via the host .htaccess.
#
# Min. 16 chars. If unset, the endpoint refuses every request (fail closed) — it
# can delete accounts, so an unset secret must never mean "open".
#
#   openssl rand -hex 32
CRON_SECRET=

# ── Email / SMTP (Netcup) ──────────────────────────────────────────────────
# Used for email verification and password reset flows (Phase 2)
SMTP_HOST=mail.your-domain.de
SMTP_PORT=587
SMTP_USER=noreply@your-domain.de
SMTP_PASS=your_smtp_password
SMTP_FROM="GourMerge <noreply@your-domain.de>"

# ── Sentry (Error Tracking) ───────────────────────────────────────────────
# From https://sentry.io → Project Settings → Client DSN
NUXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Release version injected by CI (e.g., git SHA)
NUXT_SENTRY_RELEASE=
# For source map upload in CI:
SENTRY_ORG=your-org
SENTRY_PROJECT=gourmerge
SENTRY_AUTH_TOKEN=your-auth-token

# ── App ───────────────────────────────────────────────────────────────────
# NODE_ENV is set automatically by Nuxt/Nitro.
# Used for canonical URLs in emails and SEO meta.
NUXT_PUBLIC_APP_URL=https://your-domain.de
NUXT_PUBLIC_APP_NAME=GourMerge
NUXT_PUBLIC_APP_SLOGAN="Fork the recipe, merge the flavor."

# ── Feature Flags ─────────────────────────────────────────────────────────
# Set to 'true' in production to require email verification before publishing
# recipes or opening GourMerge Requests.
REQUIRE_EMAIL_VERIFICATION=false

# ── Logging ───────────────────────────────────────────────────────────────
# Log level: 'debug' | 'info' | 'warn' | 'error' (production default: 'info')
LOG_LEVEL=info
